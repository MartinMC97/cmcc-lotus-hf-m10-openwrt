				phandle = <0x23>;
			};

			uart0-rts {
				rockchip,pins = <0x02 0x03 0x01 0x8b>;
				phandle = <0x24>;
			};

			uart0-rts-pin {
				rockchip,pins = <0x02 0x03 0x00 0x8b>;
			};
		};

		uart1 {

			uart1-xfer {
				rockchip,pins = <0x01 0x19 0x01 0x9b 0x01 0x18 0x01 0x9b>;
				phandle = <0x25>;
			};

			uart1-cts {
				rockchip,pins = <0x01 0x16 0x01 0x8b>;
				phandle = <0x26>;
			};

			uart1-rts {
				rockchip,pins = <0x01 0x17 0x01 0x8b>;
				phandle = <0x27>;
			};
		};

		uart2-m0 {

			uart2m0-xfer {
				rockchip,pins = <0x01 0x17 0x02 0x9b 0x01 0x16 0x02 0x9b>;
			};
		};

		uart2-m1 {

			uart2m1-xfer {
				rockchip,pins = <0x04 0x1b 0x02 0x9b 0x04 0x1a 0x02 0x9b>;
			};
		};

		uart3 {

			uart3-xfer {
				rockchip,pins = <0x03 0x0d 0x04 0x9b 0x03 0x0c 0x04 0x9b>;
				phandle = <0x28>;
			};
		};

		uart3-m1 {

			uart3m1-xfer {
				rockchip,pins = <0x00 0x12 0x03 0x9b 0x00 0x11 0x03 0x9b>;
			};
		};

		uart4 {

			uart4-xfer {
				rockchip,pins = <0x04 0x09 0x01 0x9b 0x04 0x08 0x01 0x9b>;
				phandle = <0x2a>;
			};

			uart4-cts {
				rockchip,pins = <0x04 0x06 0x01 0x8b>;
				phandle = <0x2b>;
			};

			uart4-rts {
				rockchip,pins = <0x04 0x07 0x01 0x8b>;
				phandle = <0x2c>;
			};

			uart4-rts-pin {
				rockchip,pins = <0x04 0x07 0x00 0x8b>;
				phandle = <0xaa>;
			};
		};

		lotus-battery {
			lotus_battery_inputs: battery-inputs {
				rockchip,pins = <4 24 0 0x93 4 25 0 0x8e>;
			};
		};

		pcfg-pull-none-0-4ma {
			bias-disable;
			drive-strength-s = <0x04>;
			phandle = <0x93>;
		};

		pcfg-pull-none-0-4ma-smt {
			bias-disable;
			drive-strength-s = <0x04>;
			input-schmitt-enable;
			phandle = <0x92>;
		};

		pcfg-pull-up-0-4ma {
			bias-pull-up;
			drive-strength-s = <0x04>;
		};

		pcfg-pull-down-0-4ma {
			bias-pull-down;
			drive-strength-s = <0x04>;
		};

		pcfg-pull-none-0-6ma {
			bias-disable;
			drive-strength-s = <0x06>;
		};

		pcfg-pull-up-0-6ma {
			bias-pull-up;
			drive-strength-s = <0x06>;
		};

		pcfg-pull-down-0-6ma {
			bias-pull-down;
			drive-strength-s = <0x06>;
		};

		pcfg-pull-none-4-6ma {
			bias-disable;
			drive-strength = <0x04>;
			drive-strength-s = <0x06>;
			phandle = <0x94>;
		};

		pcfg-pull-up-4-6ma {
			bias-pull-up;
			drive-strength = <0x04>;
			drive-strength-s = <0x06>;
			phandle = <0x97>;
		};

		pcfg-pull-down-4-6ma {
			bias-pull-down;
			drive-strength = <0x04>;
			drive-strength-s = <0x06>;
		};

		pcfg-pull-none-8-6ma {
			bias-disable;
			drive-strength = <0x08>;
			drive-strength-s = <0x06>;
			phandle = <0x98>;
		};

		pcfg-pull-up-8-6ma {
			bias-pull-up;
			drive-strength = <0x08>;
			drive-strength-s = <0x06>;
			phandle = <0x99>;
		};

		pcfg-pull-down-8-6ma {
			bias-pull-down;
			drive-strength = <0x08>;
			drive-strength-s = <0x06>;
		};

		pcfg-pull-none-8-4ma {
			bias-disable;
			drive-strength = <0x08>;
			drive-strength-s = <0x04>;
		};

		pcfg-pull-up-8-4ma {
			bias-pull-up;
			drive-strength = <0x08>;
			drive-strength-s = <0x04>;
			phandle = <0x9a>;
		};

		pcfg-pull-down-8-4ma {
			bias-pull-down;
			drive-strength = <0x08>;
			drive-strength-s = <0x04>;
		};

		pcfg-pull-none-12-4ma {
			bias-disable;
			drive-strength = <0x0c>;
			drive-strength-s = <0x04>;
		};

		pcfg-pull-up-12-4ma {
			bias-pull-up;
			drive-strength = <0x0c>;
			drive-strength-s = <0x04>;
		};

		pcfg-pull-down-12-4ma {
			bias-pull-down;
			drive-strength = <0x0c>;
			drive-strength-s = <0x04>;
		};

		pcfg-pull-none-12-6ma {
			bias-disable;
			drive-strength = <0x0c>;
			drive-strength-s = <0x06>;
			phandle = <0x90>;
		};

		pcfg-pull-up-12-6ma {
			bias-pull-up;
			drive-strength = <0x0c>;
			drive-strength-s = <0x06>;
		};

		pcfg-pull-down-12-6ma {
			bias-pull-down;
			drive-strength = <0x0c>;
			drive-strength-s = <0x06>;
		};

		buttons {

			pwr-key {
				rockchip,pins = <0x00 0x06 0x00 0x9b>;
			};

			mic-mute {
				rockchip,pins = <0x04 0x1d 0x00 0x8e>;
				phandle = <0x9d>;
			};
		};

		usb {

			usb-drv {
				rockchip,pins = <0x00 0x15 0x00 0x8b>;
				phandle = <0xa9>;
			};
		};

		sdio-pwrseq {

			wifi-enable-h {
				rockchip,pins = <0x00 0x02 0x00 0x8b>;
				phandle = <0x9e>;
			};
		};

		wireless-bluetooth {

			uart4-gpios {
				rockchip,pins = <0x04 0x07 0x00 0x8b>;
			};
		};

		wireless-wlan {

			wifi-wake-host {
				rockchip,pins = <0x00 0x00 0x00 0x9b>;
				phandle = <0xab>;
			};
		};
	};

	chosen {
		bootargs = "console=ttyS2,1500000n8 rdinit=/init loglevel=8 ignore_loglevel panic=3 oops=panic clk_ignore_unused lotus.root=nand";
	};

	adc-keys {
		compatible = "adc-keys";
		io-channels = <0x9c 0x01>;
		io-channel-names = "buttons";
		poll-interval = <0x64>;
		keyup-threshold-microvolt = <0x1b7740>;

		vol-down-key {
			linux,code = <0x72>;
			label = "volume down";
			press-threshold-microvolt = <0x98580>;
		};

		vol-up-key {
			linux,code = <0x73>;
			label = "volume up";
			press-threshold-microvolt = <0x493e0>;
		};

		mic-mute-key {
			linux,code = <0xf8>;
			label = "microphone mute";
			press-threshold-microvolt = <0xdbf88>;
		};
	};

	dummy-codec {
		compatible = "rockchip,dummy-codec";
		#sound-dai-cells = <0x00>;
		phandle = <0xa2>;
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <0x9d>;

		play-pause-key {
			gpios = <0x2d 0x1d 0x00>;
			linux,code = <0xa4>;
			label = "play/power";
			debounce-interval = <0x64>;
		};
	};

	battery-indicator {
		compatible = "lotus,mini-battery-indicator";
		pinctrl-names = "default";
		pinctrl-0 = <&lotus_battery_inputs>;
		indicator-gpios = <0x2d 25 1>;
		charge-gpios = <0x2d 24 1>;
		status = "okay";
	};

	sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <0x9e>;
		reset-gpios = <0x1d 0x02 0x01>;
		post-power-on-delay-ms = <0xc8>;
		phandle = <0x7c>;
	};

	bluetooth-sound {
		status = "disabled";
		compatible = "rockchip,multicodecs-card";
		rockchip,card-name = "rockchip,rk3308-pcm";
		rockchip,mclk-fs = <0x80>;
		rockchip,cpu = <0xa1>;
		rockchip,codec = <0xa2>;
		rockchip,format = "dsp_b";
		rockchip,bitclock-inversion = <0x00>;
		rockchip,wait-card-locked = <0x00>;
	};

	spdif-dummy-codec {
		compatible = "rockchip,dummy-codec";
		#sound-dai-cells = <0x00>;
		phandle = <0xa5>;
	};

	spdif-rx-sound {
		status = "disabled";
		compatible = "rockchip,multicodecs-card";
		rockchip,card-name = "rockchip,spdif-rx";
		rockchip,mclk-fs = <0x80>;
		rockchip,cpu = <0xa3>;
		rockchip,codec = <0xa2>;
	};

	spdif-tx-sound {
		status = "disabled";
		compatible = "rockchip,multicodecs-card";
		rockchip,card-name = "rockchip,spdif-tx";
		rockchip,mclk-fs = <0x80>;
		rockchip,cpu = <0xa4>;
		rockchip,codec = <0xa5>;
	};

	tas5731-sound {
		status = "disabled";
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
		simple-audio-card,name = "rockchip,tas5731";
		simple-audio-card,mclk-fs = <0x100>;

		simple-audio-card,cpu {
			sound-dai = <0xa6>;
		};

		simple-audio-card,codec {
			sound-dai = <0xa7>;
		};
	};

	vdd-core {
		compatible = "pwm-regulator";
		pwms = <0xa8 0x00 0x1388 0x01>;
		regulator-name = "vdd_core";
		regulator-min-microvolt = <0xc9e78>;
		regulator-max-microvolt = <0x147260>;
		regulator-init-microvolt = <0xf7cd8>;
		regulator-always-on;
		regulator-boot-on;
		regulator-settling-time-up-us = <0xfa>;
		status = "okay";
		phandle = <0x07>;
	};

	vdd-log {
		compatible = "regulator-fixed";
		regulator-name = "vdd_log";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x100590>;
		regulator-max-microvolt = <0x100590>;
	};

	vdd-1v0 {
		compatible = "regulator-fixed";
		regulator-name = "vdd_1v0";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0xf4240>;
		regulator-max-microvolt = <0xf4240>;
	};

	vcc-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		vin-supply = <0x14>;
		phandle = <0x15>;
	};

	vccio-sd {
		compatible = "regulator-gpio";
		regulator-name = "vccio_sd";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x325aa0>;
		gpios = <0x1d 0x0f 0x00>;
		states = <0x1b7740 0x00 0x325aa0 0x01>;
		phandle = <0x17>;
	};

	vcc-sd {
		compatible = "regulator-fixed";
		gpio = <0x2d 0x1e 0x01>;
		regulator-name = "vcc_sd";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		phandle = <0x78>;
	};

	vcc-1v8-codec {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v8_codec";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		vin-supply = <0x14>;
	};

	vcc-ddr {
		compatible = "regulator-fixed";
		regulator-name = "vcc_ddr";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x16e360>;
		regulator-max-microvolt = <0x16e360>;
	};

	vcc-io {
		compatible = "regulator-fixed";
		regulator-name = "vcc_io";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		phandle = <0x14>;
	};

	vccio-flash {
		compatible = "regulator-fixed";
		regulator-name = "vccio_flash";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		phandle = <0x16>;
	};

	vcc-phy-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc_phy";
		regulator-always-on;
		regulator-boot-on;
		phandle = <0x86>;
	};

	vbus-host-regulator {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <0x1d 0x15 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0xa9>;
		regulator-name = "vbus_host";
		phandle = <0x19>;
	};

	wireless-bluetooth {
		compatible = "bluetooth-platdata";
		uart_rts_gpios = <0x2d 0x07 0x01>;
		pinctrl-names = "default", "rts_gpio";
		pinctrl-0 = <0x2c>;
		pinctrl-1 = <0xaa>;
		BT,power_gpio = <0x2d 0x0b 0x00>;
		BT,wake_host_irq = <0x2d 0x0c 0x00>;
		status = "disabled";
	};

	wireless-wlan {
		compatible = "wlan-platdata";
		rockchip,grf = <0x51>;
		pinctrl-names = "default";
		pinctrl-0 = <0xab 0xac>;
		wifi_chip_type = "ap6255";
		WIFI,host_wake_irq = <0x1d 0x00 0x01>;
		status = "okay";
	};

	memory@200000 {
		device_type = "memory";
		reg = <0x00 0x200000 0x00 0x7e00000>;
	};

	gpio-leds {
		compatible = "gpio-leds";

		redled {
			gpios = <0x55 0x01 0x01>;
			label = "redled";
			default-state = "off";
		};

		greenled {
			gpios = <0x55 0x00 0x01>;
			label = "greenled";
			default-state = "off";
		};

		blueled {
			gpios = <0x55 0x02 0x01>;
			label = "blueled";
			default-state = "off";
		};
	};
};
