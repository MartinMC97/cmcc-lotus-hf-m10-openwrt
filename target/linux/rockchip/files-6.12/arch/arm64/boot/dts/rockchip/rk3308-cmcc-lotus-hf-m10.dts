	};

	thermal-zones {

		soc-thermal {
			polling-delay-passive = <0x14>;
			polling-delay = <0x3e8>;
			sustainable-power = <0x168>;
			thermal-sensors = <0x4f 0x00>;

			trips {

				lotus_soc_early: trip-point@0 {
					temperature = <0x11170>;
					hysteresis = <0x7d0>;
					type = "passive";
				};

				trip-point@1 {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x50>;
				};

				soc-crit {
					temperature = <0x1c138>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};

			cooling-maps {

				/* Start cooling before the old 85 C target. On this
				 * six-OPP CPU, active states 1..3 cap at 1200..816 MHz.
				 * A lower bound of zero permits full-speed recovery.
				 * The existing 85 C map can request deeper cooling. */
				early-cpu {
					trip = <&lotus_soc_early>;
					cooling-device = <0x09 0 3>;
				};

				map0 {
					trip = <0x50>;
					cooling-device = <0x09 0xffffffff 0xffffffff>;
					contribution = <0x1000>;
				};
			};
		};

		gpu-thermal {
			polling-delay-passive = <0x64>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x4f 0x01>;

			trips {

				/* Channel 1 is an internal logic sensor, despite
				 * the historical node name. Keep its final protection. */
				lotus_logic_early: logic-passive {
					temperature = <70000>;
					hysteresis = <2000>;
					type = "passive";
				};

				lotus_logic_hot: logic-hot {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				gpu_crit {
					temperature = <0x1c138>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};

			cooling-maps {
				early-cpu {
					trip = <&lotus_logic_early>;
					cooling-device = <0x09 0 3>;
				};
				hot-cpu {
					trip = <&lotus_logic_hot>;
					cooling-device = <0x09 0xffffffff 0xffffffff>;
				};
			};
		};
	};

