#!/bin/sh /etc/rc.common
# Disabled until Bluetooth, sound and operator playback validation pass.
START=95
STOP=10
USE_PROCD=1

start_service() {
    local enabled
    config_load lotus_bluealsa
    config_get_bool enabled main enabled 0
    [ "$enabled" -eq 1 ] || return 0
    [ -S /var/run/dbus/system_bus_socket ] || return 1
    [ -e /dev/snd/pcmC0D0p ] || return 1

    procd_open_instance daemon
    procd_set_param command /usr/bin/bluealsa -p a2dp-sink --initial-volume=25
    procd_set_param env DBUS_SYSTEM_BUS_ADDRESS=unix:path=/var/run/dbus/system_bus_socket
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    procd_open_instance playback
    procd_set_param command /usr/bin/bluealsa-aplay -D lotus_bt --single-audio
    procd_set_param env DBUS_SYSTEM_BUS_ADDRESS=unix:path=/var/run/dbus/system_bus_socket ALSA_CONFIG_PATH=/etc/lotus-bt-asound.conf
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger lotus_bluealsa
}
